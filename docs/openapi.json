{
  "openapi": "3.1.0",
  "info": {
    "title": "TexCompiler",
    "version": "2.0.0-rc.1",
    "description": "Native Rust LaTeX service. Authentication is optional on all listeners. Caching, asynchronous jobs and WASM are not implemented."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/compile": {
      "post": {
        "summary": "Compile a source or project",
        "description": "Binary PDF success. Source-only requests use document.tex; main_file applies to files projects. Explicit engines are honored. A bearer token is required when configured.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated PDF",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "X-TexCompiler-Engine": {
                "schema": {
                  "type": "string"
                }
              },
              "X-TexCompiler-Pages": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "X-TexCompiler-Method": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid project, unsupported engine/backend or TeX failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 32 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Malformed JSON request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Worker or preparation capacity exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Native worker unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
