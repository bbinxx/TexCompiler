    "/health": {
      "get": {
        "summary": "Liveness and compilation status",
        "responses": {
          "200": {
            "description": "Liveness; compilation_ready reflects the startup probe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Liveness and compilation status",
        "responses": {
          "200": {
            "description": "Liveness; compilation_ready reflects the startup probe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/compilers": {
      "get": {
        "summary": "Installed allowlisted engines",
        "responses": {
          "200": {
            "description": "Sorted engine names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "compilers"
                  ],
                  "properties": {
                    "compilers": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "pdflatex",
                          "xelatex",
                          "lualatex"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/engines": {
      "get": {
        "summary": "Installed allowlisted engines",
        "responses": {
          "200": {
            "description": "Sorted engine names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "compilers"
                  ],
                  "properties": {
                    "compilers": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "pdflatex",
                          "xelatex",
                          "lualatex"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "Startup compilation succeeded"
          },
          "503": {
            "description": "Startup worker/TeX probe failed"
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "summary": "Available backend capabilities",
        "responses": {
          "200": {
            "description": "Only implemented features are advertised",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "backends": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "native"
                        ]
                      }
                    },
                    "compilation_ready": {
                      "type": "boolean"
                    },
                    "production_ready": {
                      "type": "boolean"
                    },
                    "experimental": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CompileRequest": {
        "type": "object",
        "anyOf": [
          {
            "required": [
              "code"
            ]
          },
          {
            "required": [
              "files"
            ]
          }
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 256,
            "additionalProperties": {
              "type": "string"
            },
            "description": "Project-relative paths to UTF-8 text or base64 binary assets. Legacy base64 .cls/.sty values are accepted. Maximum 20 MiB decoded."
          },
          "main_file": {
            "type": "string",
            "default": "document.tex"
          },
          "compiler": {
            "type": "string",
            "enum": [
              "pdflatex",
              "xelatex",
              "lualatex"
            ],
            "description": "Omit or send empty string for automatic detection."
          },
          "backend": {
            "type": "string",
            "enum": [
              "native",
              "auto"
            ],
            "default": "auto"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "log": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version",
          "compilers",
          "compilation_ready",
          "production_ready"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "compilers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "latexmk": {
            "type": "string"
          },
          "compilation_ready": {
            "type": "boolean"
          },
          "production_ready": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
