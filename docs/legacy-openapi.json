{
  "openapi": "3.1.0",
  "info": {
    "title": "TexCompiler API",
    "description": "A high-performance LaTeX to PDF compilation service.",
    "version": "1.3.0"
  },
  "paths": {
    "/compile": {
      "post": {
        "summary": "Compile Tex",
        "operationId": "compile_tex_compile_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/compile/bundle": {
      "post": {
        "summary": "Compile Bundle",
        "operationId": "compile_bundle_compile_bundle_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_compile_bundle_compile_bundle_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/detect-compiler": {
      "post": {
        "summary": "Detect Compiler Endpoint",
        "operationId": "detect_compiler_endpoint_detect_compiler_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectCompilerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/compilers": {
      "get": {
        "summary": "Get Compilers",
        "operationId": "get_compilers_compilers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_compile_bundle_compile_bundle_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "main_file": {
            "type": "string",
            "title": "Main File",
            "default": "main.tex"
          },
          "compiler": {
            "type": "string",
            "title": "Compiler",
            "default": "pdflatex"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_compile_bundle_compile_bundle_post"
      },
      "CompileRequest": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "files": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Files"
          },
          "main_file": {
            "type": "string",
            "title": "Main File",
            "default": "document.tex"
          },
          "compiler": {
            "type": "string",
            "title": "Compiler",
            "default": "pdflatex"
          }
        },
        "type": "object",
        "title": "CompileRequest"
      },
      "DetectCompilerRequest": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "preferred": {
            "type": "string",
            "title": "Preferred",
            "default": "pdflatex"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "DetectCompilerRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
