    "/compile/bundle": {
      "post": {
        "summary": "Compile a ZIP project",
        "description": "Binary PDF success. Source-only requests use document.tex; main_file applies to files projects. Explicit engines are honored. A bearer token is required when configured.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "ZIP, at most 256 entries and 20 MiB expanded"
                  },
                  "main_file": {
                    "type": "string",
                    "default": "main.tex"
                  },
                  "compiler": {
                    "type": "string",
                    "enum": [
                      "pdflatex",
                      "xelatex",
                      "lualatex"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated PDF",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "X-TexCompiler-Engine": {
                "schema": {
                  "type": "string"
                }
              },
              "X-TexCompiler-Pages": {
                "schema": {
