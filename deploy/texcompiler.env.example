# Copy to /etc/texcompiler/texcompiler.env for the systemd template.
# Keep the real file root-owned and mode 0600. Do not commit real tokens.
TEXCOMPILER_BIND=127.0.0.1:8001
# Generate a token with openssl rand -hex 32. Optional. Leave unset to allow unauthenticated compilation.
# TEXCOMPILER_API_TOKEN=
RUST_LOG=info
