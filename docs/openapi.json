    "/detect-compiler": {
      "post": {
        "summary": "Conservative engine recommendation",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "preferred": {
                    "type": "string",
                    "enum": [
                      "pdflatex",
                      "xelatex",
                      "lualatex"
                    ],
                    "default": "pdflatex"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recommendation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "compiler"
                  ],
                  "properties": {
                    "compiler": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid project, unsupported engine/backend or TeX failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication required",
